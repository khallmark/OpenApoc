{
	"version": 6,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 30,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "macos",
			"displayName": "macOS Homebrew (dev)",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"ENABLE_TESTS": "OFF",
				"BUILD_IMAGEDUMP": "OFF",
				"BUILD_SERIALIZATIONTOOL": "OFF"
			}
		},
		{
			"name": "macos-signed",
			"displayName": "macOS vcpkg static + Developer ID",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-signed",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "RelWithDebInfo",
				"VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
				"VCPKG_TARGET_TRIPLET": "arm64-osx-static",
				"BUILD_LAUNCHER": "OFF",
				"EXTRACT_DATA": "OFF",
				"ENABLE_TESTS": "OFF",
				"BUILD_IMAGEDUMP": "OFF",
				"BUILD_SERIALIZATIONTOOL": "OFF",
				"USE_SYSTEM_QT": "ON"
			}
		},
		{
			"name": "ios-device",
			"displayName": "iOS device (iPad + iPhone)",
			"generator": "Xcode",
			"binaryDir": "${sourceDir}/build-ios",
			"environment": {
				"DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
			},
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": {
				"CMAKE_SYSTEM_NAME": "iOS",
				"CMAKE_OSX_ARCHITECTURES": "arm64",
				"CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
				"VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-triplets",
				"VCPKG_TARGET_TRIPLET": "arm64-ios",
				"BUILD_LAUNCHER": "OFF",
				"EXTRACT_DATA": "OFF",
				"ENABLE_TESTS": "OFF",
				"BUILD_EXTRACTOR": "OFF",
				"BUILD_IMAGEDUMP": "OFF",
				"BUILD_SERIALIZATIONTOOL": "OFF",
				"BUILD_GAMESTATESERIALIZEGEN": "OFF"
			}
		}
	],
	"buildPresets": [
		{
			"name": "macos",
			"configurePreset": "macos"
		},
		{
			"name": "macos-signed",
			"configurePreset": "macos-signed"
		},
		{
			"name": "ios-device",
			"configurePreset": "ios-device"
		}
	]
}
