    "pr-1237": {
      "expected": {"file_count": 4, "hunk_count": 7, "body_count": 1, "issue_comment_count": 6, "review_count": 0, "review_comment_count": 0},
      "body_segments": [
        {"line_index": 0, "line_text": "Addresses #997, #1216 so far.", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 2, "line_text": "The following is a list of what appears to have been fixed, many are very lightly tested and the changes could very easily have affected things in other parts of the game that I don't yet know about. This is just a running list to help me keep track of what has been done.", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 4, "line_text": "### Battlescape", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 6, "line_text": "- Walking speed seems to be a bit faster, closer to the original.", "kind": "requirement", "disposition_rows": ["R1237-05"]},
        {"line_index": 7, "line_text": "- Explosive hazard type doesn't leave smoke behind anymore, it stayed around way too long. Was this a feature?", "kind": "requirement", "disposition_rows": ["R1237-10"]},
        {"line_index": 8, "line_text": "- Explosions now expand faster to more closely match the OG game.", "kind": "requirement", "disposition_rows": ["R1237-08"]},
        {"line_index": 9, "line_text": "- Explosions seem to be the correct radius now, although this needs more testing. I have only tried a couple items.", "kind": "requirement", "disposition_rows": ["R1237-08"]},
        {"line_index": 11, "line_text": "### Cityscape", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 12, "line_text": "NA", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 14, "line_text": "### Both", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 16, "line_text": "- Projectile speed has been increased, it seems much closer to the OG game. TICK_SCALE was set to 18 instead of 36 in this case. This has not been tested in cityscape, likely will cause issues somewhere.", "kind": "requirement", "disposition_rows": ["R1237-03", "R1237-06"]},
        {"line_index": 18, "line_text": "### Problems", "kind": "context_no_requirement", "disposition_rows": []},
        {"line_index": 20, "line_text": "- [ ] Rate of fire is now too fast. Should seperate speed from ROF if that is what is happening.", "kind": "requirement", "disposition_rows": ["R1237-07", "R1237-11"]}
      ],
